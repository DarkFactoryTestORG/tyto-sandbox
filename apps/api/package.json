{
  "name": "@plotline/api",
  "version": "0.1.0",
  "private": true,
  "description": "Plotline's API: NestJS, Passport (session cookies), Drizzle on Postgres.",
  "main": "dist/main.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "tsc -p tsconfig.build.json && node --enable-source-maps dist/main.js",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "11.1.8",
    "@nestjs/core": "11.1.8",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.1.8",
    "@plotline/db": "workspace:*",
    "@plotline/shared": "workspace:*",
    "@plotline/textkit": "workspace:*",
    "bcryptjs": "3.0.2",
    "connect-pg-simple": "10.0.0",
    "drizzle-orm": "0.44.7",
    "express-session": "1.18.2",
    "passport": "0.7.0",
    "passport-custom": "1.1.1",
    "passport-local": "1.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@nestjs/testing": "11.1.8",
    "@swc/core": "1.13.5",
    "@types/connect-pg-simple": "7.0.3",
    "@types/express": "5.0.5",
    "@types/express-session": "1.18.2",
    "@types/node": "22.18.13",
    "@types/passport": "1.0.17",
    "@types/passport-local": "1.0.38",
    "@types/supertest": "6.0.3",
    "supertest": "7.1.4",
    "unplugin-swc": "1.5.8",
    "vitest": "3.2.4"
  }
}
