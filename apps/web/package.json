{
  "name": "@plotline/web",
  "version": "0.1.0",
  "private": true,
  "description": "Plotline's web app: Next.js App Router, React, @plotline/ui-kit.",
  "scripts": {
    "build": "next build",
    "start": "next start --port ${PORT:-3000}",
    "dev": "next dev --port ${PORT:-3000}",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@plotline/shared": "workspace:*",
    "@plotline/ui-kit": "workspace:^3.8.2",
    "next": "15.5.6",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.18.13",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "@vitejs/plugin-react": "5.0.4",
    "jsdom": "26.1.0",
    "vitest": "3.2.4"
  }
}
