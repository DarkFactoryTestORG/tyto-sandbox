# Local development. Copy to .env and adjust.
DATABASE_URL=postgres://plotline:plotline@localhost:5432/plotline
SESSION_SECRET=dev-only-session-secret-change-me
PLOTLINE_SECRET_KEY=dev-only-secret-key-change-me
# The dev auth bypass (header or cookie x-plotline-dev-user: <email>). Never in production.
PLOTLINE_DEV_AUTH=1
# Comma-separated feature flags, e.g. recurring-tasks
PLOTLINE_FLAGS=
API_URL=http://localhost:4000
